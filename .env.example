# Server-only compatible Chat Completions endpoint, ending in /v1 if required.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_CODE_MAX_TOKENS=6000
LLM_DISABLE_THINKING=true
ALLOW_FALLBACK=true
JOB_TIMEOUT_SECONDS=240
MAX_CONCURRENT_JOBS=4
REQUESTS_PER_MINUTE=30
# Same-origin deployment: keep empty. Never use a wildcard with credentials.
ALLOWED_ORIGINS=
PORT=8000

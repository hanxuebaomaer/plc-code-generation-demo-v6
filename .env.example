# OpenAI-compatible model service
# Fill in the address provided by your model service.
# Other providers may use a base ending in /v1.
LLM_API_BASE=https://your-model-service.example/v1
LLM_API_KEY=
LLM_MODEL=your-model-name
LLM_TIMEOUT_SECONDS=60
LLM_CODE_MAX_TOKENS=3800
LLM_DISABLE_THINKING=true

# Repeated identical demo requests can reuse a recent successful model result.
GENERATION_CACHE_TTL_SECONDS=3600
GENERATION_CACHE_MAX_ENTRIES=64

# Normally leave blank because frontend and API are served from the same origin.
# For a separate local frontend, use comma-separated origins.
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
